{
  "name": "astro-bumpers",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @astro-bumpers/icongen build && pnpm -r --parallel --filter './apps/**' dev",
    "build": "pnpm --filter @astro-bumpers/icongen build && pnpm -r --filter './packages/**' build && pnpm -r --filter './apps/**' build",
    "clean": "pnpm -r exec rm -rf dist node_modules .turbo",
    "typecheck": "pnpm -r --filter './apps/**' --filter './packages/**' typecheck"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
